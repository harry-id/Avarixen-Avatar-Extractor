# tools/.env.example — copy to tools/.env and edit.
# Loaded by tools/convert-bench.sh. Command-line env vars still override these.

# API origin to hit.
# Production (Cloudflare, TLS): https://api.harrycore.web.id
BASE_URL=https://api.harrycore.web.id

# Roblox user ID to convert.
USER_ID=4437958744

# Space-separated formats to fire in parallel.
FORMATS=glb gltf fbx

# Mesh quality 0-4 (0 Minimal, 1 Low, 2 Medium, 3 High, 4 Extreme).
SUBDIVISION=2

# Auto-rig (1/0) and R6 extra bones (1/0).
RIG=1
MORE_JOINTS=0

# Download/cache the avatar before converting (1/0).
DOWNLOAD=1

# Repeat the whole batch this many times.
ROUNDS=1

# Directory for output files (a timestamped subdir is created inside).
OUT_DIR=/tmp/convert-bench