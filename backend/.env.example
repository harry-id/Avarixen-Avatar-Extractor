ROBLOX_API_KEY=your_roblox_api_key_here
# Recommended in production (suppresses framework development behavior).
# NODE_ENV=production
# Optional: backend port (default 3000) and bind address (default 127.0.0.1).
# Set HOST=0.0.0.0 only when direct public binding is intentional.
# PORT=3000
# HOST=127.0.0.1
# Required in production if the backend is public. Comma-separated allowed origins.
# CORS_ORIGINS=https://harry-id.github.io
# Proxy identity. "cloudflare" trusts CF-Connecting-IP only from a loopback
# cloudflared peer. Use "1" or a CIDR list only when the origin is protected.
# TRUST_PROXY=cloudflare
# Cache quota. The server defaults to 5 GiB when unset. Set 0 only for an
# explicitly unlimited cache.
# DOWNLOADS_MAX_BYTES=5368709120
# Refuse new downloads below this much free disk space (default 512 MiB).
# MIN_FREE_DISK_BYTES=536870912
# Download admission control and byte limits.
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_DOWNLOAD_QUEUE=8
# MAX_ASSET_BYTES=67108864
# MAX_AVATAR_BYTES=268435456
# MAX_METADATA_BYTES=8388608
# DOWNLOAD_TIMEOUT_MS=120000
# Conversion concurrency, queue, and OBJ input limits.
# MAX_CONCURRENT_CONVERSIONS=2
# MAX_CONVERSION_QUEUE=8
# Conversions run on a pool of worker threads sized to MAX_CONCURRENT_CONVERSIONS.
# MAX_WORKER_HEAP_MB caps each worker's V8 old-generation heap (default 512).
# MAX_WORKER_RECYCLE_JOBS recycles a worker after this many jobs (default 50).
# CONVERSION_DEADLINE_MS cancels a conversion (504) after this many ms; keep it
# below the client/proxy request timeout (default 110000).
# MAX_WORKER_HEAP_MB=512
# MAX_WORKER_RECYCLE_JOBS=50
# CONVERSION_DEADLINE_MS=110000
# MAX_CONCURRENT_PARTS=2
# MAX_PARTS_QUEUE=8
# MAX_OBJ_BYTES=67108864
# MAX_OBJ_VERTICES=1500000
# MAX_OBJ_FACES=1000000
# Output-face budgets for mesh-quality subdivision (defaults: 500000 GLB/glTF,
# 400000 FBX). Invalid/zero/negative values fall back to the default; valid
# values are clamped to the 3.5M hard cap.
# MAX_OUTPUT_FACES=500000
# MAX_OUTPUT_FACES_FBX=400000
# Optional: API rate limit (defaults: 60 requests per 60 seconds per IP).
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
# Stricter per-IP limit for the expensive download route, on top of the global
# limit above (defaults: 10 requests per 60 seconds per IP).
# DOWNLOAD_RATE_LIMIT_MAX=10
# DOWNLOAD_RATE_LIMIT_WINDOW_MS=60000
# Optional: inbound server timeouts in milliseconds.
# REQUEST_TIMEOUT_MS=120000
# HEADERS_TIMEOUT_MS=30000
# KEEP_ALIVE_TIMEOUT_MS=65000
# Optional: request logging. Default on; set "false" to disable, or "verbose"
# to also log request bodies and user agents.
# LOG_REQUESTS=true
# Optional: per-file CDN asset download logs (noisy; default off)
# LOG_ASSETS=1
# Optional: file logging. The backend writes a clean (ANSI-stripped) copy of
# every console line to a log file. Defaults to <backend>/aae.log; set
# AAE_LOG_FILE=false to disable, or point it at a custom path.
# AAE_LOG_FILE=aae.log
# Minimum level written to the file: debug|info|warn|error (default info).
# AAE_LOG_LEVEL=info
# Optional: rotate the log at this size (bytes; 0 disables) and keep N files.
# AAE_LOG_MAX_BYTES=10485760
# AAE_LOG_MAX_FILES=3
