ROBLOX_API_KEY=your_roblox_api_key_here
# Recommended in production (suppresses framework development behavior).
# NODE_ENV=production
# Optional: backend port (default 3000)
# PORT=3000
# Optional: comma-separated allowed CORS origins for the frontend (default allows all; set in production)
# CORS_ORIGINS=http://localhost:3001
# Optional: trust proxy setting when the API is behind a reverse proxy
# (e.g. 1, true, or a CIDR list). Set false/0 to explicitly disable.
# TRUST_PROXY=1
# Optional: cache quota in bytes (0 = unlimited; age TTL still applies).
# DOWNLOADS_MAX_BYTES=5368709120
# Optional: conversion concurrency and queue limits.
# MAX_CONCURRENT_CONVERSIONS=2
# MAX_CONVERSION_QUEUE=8
# Optional: API rate limit (defaults: 60 requests per 60 seconds per IP).
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
# Optional: inbound server timeouts in milliseconds.
# REQUEST_TIMEOUT_MS=120000
# HEADERS_TIMEOUT_MS=30000
# KEEP_ALIVE_TIMEOUT_MS=65000
# Optional: request logging. Default on; set "false" to disable, or "verbose"
# to also log request bodies and user agents.
# LOG_REQUESTS=true
# Optional: per-file CDN asset download logs (noisy; default off)
# LOG_ASSETS=1
# Optional: file logging. The backend writes a clean (ANSI-stripped) copy of
# every console line to a log file. Defaults to <backend>/aae.log; set
# AAE_LOG_FILE=false to disable, or point it at a custom path.
# AAE_LOG_FILE=aae.log
# Minimum level written to the file: debug|info|warn|error (default info).
# AAE_LOG_LEVEL=info
# Optional: rotate the log at this size (bytes; 0 disables) and keep N files.
# AAE_LOG_MAX_BYTES=10485760
# AAE_LOG_MAX_FILES=3
